APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=5000

# Genera valores distintos y largos. Ejemplo PowerShell:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REEMPLAZA_CON_UNA_CLAVE_ALEATORIA_LARGA
QR_SECRET_KEY=REEMPLAZA_CON_OTRA_CLAVE_ALEATORIA_LARGA

# Se usa únicamente al ejecutar seed.py; no existe una contraseña fija en el código.
ADMIN_INITIAL_PASSWORD=CAMBIA_ESTA_CONTRASENA

DATABASE_URL=sqlite:///./smart_access.db
ACCESS_COOLDOWN_SECONDS=10
TIMEZONE=America/Mexico_City
DEVICE_IDENTIFIER=KIOSK-ENTRADA-01
INSTITUTION_NAME=Escáner School
SESSION_HTTPS_ONLY=false
MAX_UPLOAD_MB=5
CAPACITY_LIMIT=500
